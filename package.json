{
  "name": "npi-solar-erp",
  "version": "0.1.0",
  "private": true,
  "description": "NPI Solar ERP — ZATCA-native vertical solar ERP for the Saudi/GCC market (modular monolith).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm run generate -w @npi/db",
    "db:migrate": "npm run migrate -w @npi/db",
    "db:seed": "npm run seed -w @npi/db",
    "db:seed:madar-scratch": "npm run seed:madar-scratch -w @npi/db",
    "db:studio": "npm run studio -w @npi/db",
    "dev:api": "npm run dev -w @npi/api",
    "dev:web": "npm run dev -w @npi/web",
    "build": "npm run build -w @npi/shared && npm run build -w @npi/db && npm run build -w @npi/api && npm run build -w @npi/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:start": "C:/Users/eyadq/.npi-erp/pgsql/bin/pg_ctl.exe -D C:/Users/eyadq/.npi-erp/data -l C:/Users/eyadq/.npi-erp/server.log start",
    "db:stop": "C:/Users/eyadq/.npi-erp/pgsql/bin/pg_ctl.exe -D C:/Users/eyadq/.npi-erp/data stop",
    "test": "npm run test -w @npi/api",
    "test:int": "npm run test:int -w @npi/api",
    "db:deploy": "npm run migrate:deploy -w @npi/db",
    "lint": "eslint .",
    "copilot:dev": "node scripts/copilot-dev.mjs",
    "copilot:build": "npm run build -w @npi/copilot",
    "copilot:migrate": "npm run migrate -w @npi/copilot",
    "copilot:gen-types": "npm run gen-types -w @npi/copilot --"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
