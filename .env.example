# ─── Database ─────────────────────────────────────────────────────────────
# Matches docker-compose.yml. For production, point at your in-Kingdom Postgres.
DATABASE_URL="postgresql://npi:npi_dev_password@localhost:5432/npi_erp?schema=public"

# ─── API ──────────────────────────────────────────────────────────────────
API_PORT=4000
# Change this in every non-dev environment. Used to sign JWT access tokens.
JWT_SECRET="" # REQUIRED: generate with `openssl rand -hex 32` — placeholders and short values are rejected at boot
JWT_EXPIRES_IN="12h"
# Comma-separated origins allowed to call the API (the web app).
CORS_ORIGINS="http://localhost:3000"

# ─── Web ──────────────────────────────────────────────────────────────────
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── Local development flags ──────────────────────────────────────────────
# Swagger/OpenAPI at /api/docs and /api/docs-json. Off in every deployed
# environment; on locally, because the copilot's type generation reads
# /api/docs-json at build time (spec/madar T-04).
EXPOSE_API_DOCS=1
# Login-page demo-credential prefill. Build-time flag (NEXT_PUBLIC_*).
NEXT_PUBLIC_DEMO_PREFILL=1
