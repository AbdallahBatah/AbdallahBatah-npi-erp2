# انسخ هذا الملف إلى deploy/.env وعدّل القيم — لا ترفع deploy/.env لأي مكان عام.

# كلمة مرور قاعدة البيانات (اختر كلمة قوية عشوائية)
POSTGRES_PASSWORD=ChangeMe_StrongDbPassword

# سر توقيع الجلسات — ولّده بأمر: openssl rand -hex 32
JWT_SECRET=ChangeMe_Run_openssl_rand_hex_32

# مدة صلاحية الجلسة
JWT_EXPIRES_IN=12h

# عنوان الموقع:
#   :80                    → HTTP على عنوان IP مباشرة (بلا دومين)
#   203-0-113-10.sslip.io  → HTTPS تلقائي بلا شراء دومين (استبدل بأرقام IP خادمك مفصولة بشرطات)
#   demo.npi-erp.sa        → HTTPS تلقائي عند امتلاك دومين
SITE_ADDRESS=:80
