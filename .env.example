# ─── Database ─────────────────────────────────────────────────────────────
# Matches docker-compose.yml. For production, point at your in-Kingdom Postgres.
DATABASE_URL="postgresql://npi:npi_dev_password@localhost:5432/npi_erp?schema=public"

# ─── API ──────────────────────────────────────────────────────────────────
API_PORT=4000
# Change this in every non-dev environment. Used to sign JWT access tokens.
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="12h"
# Comma-separated origins allowed to call the API (the web app).
CORS_ORIGINS="http://localhost:3000"

# ─── Web ──────────────────────────────────────────────────────────────────
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL="http://localhost:4000"
