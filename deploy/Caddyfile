# NPI Solar ERP — single-origin gateway.
# SITE_ADDRESS=":80"            → plain HTTP on the server IP (no domain needed).
# SITE_ADDRESS="1-2-3-4.sslip.io" or "demo.example.com" → automatic HTTPS.
{$SITE_ADDRESS} {
	encode gzip

	# lb_try_duration: during a rolling swap the old container disappears
	# mid-flight; retrying the dial for a few seconds moves the request to the
	# new one instead of surfacing a 502 to whoever clicked at the wrong moment.
	# Safe to retry because the serializable write paths are DB-idempotent and
	# reads carry no side effects.
	handle /api/* {
		reverse_proxy api:4000 {
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy web:3000 {
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}
