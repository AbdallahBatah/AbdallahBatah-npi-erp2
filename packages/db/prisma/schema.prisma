// ─────────────────────────────────────────────────────────────────────────
// NPI Solar ERP — Prisma schema
// Scope: W0 (shared kernel) + W1 (Sell & Contract vertical slice).
//
// Design decisions carried from the build spec (§4):
//   • Every tenant-scoped row carries organizationId (row-level tenancy).
//   • AuditLog is append-only (corrections are new rows, never edits).
//   • Bilingual reference data uses paired *_ar / *_en fields, not a join table.
//   • Money is Decimal(18,2); capacity is Decimal(12,3) kWp.
// The remaining ~55 entities (project, procurement, finance/ZATCA, O&M,
// telemetry, PPA) attach onto this spine in later waves — see README roadmap.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Locale {
  AR
  EN
}

enum CustomerType {
  RESIDENTIAL
  CI // commercial & industrial
  UTILITY
  GOVERNMENT
}

/// CRM Phase 1 (Step 2): a customer is a business or a person. For a NEW record
/// a COMPANY must carry a CR or VAT number and an INDIVIDUAL a mobile number.
enum CustomerEntityKind {
  COMPANY
  INDIVIDUAL
}

enum LeadSource {
  WEBSITE
  REFERRAL
  CAMPAIGN
  DIRECT
  WHATSAPP
  OTHER
}

enum LeadStatus {
  /// جارٍ التفاوض — every lead starts here (owner work cycle 2026-10-29, step 2).
  NEGOTIATING
  /// تم القبول — set together with the automatic conversion to an opportunity.
  ACCEPTED
  /// تم الرفض — needs a reason from the loss-reason list.
  REJECTED
}

/// The company's order (owner work cycle 2026-10-29, ADR-03 §4-2):
/// فرصة جديدة ← دراسة وتكلفة ← موازنة / عرض سعر ← تفاوض على العرض ← رابحة | خاسرة.
/// COST_STUDY is migration 0024's QUALIFICATION, renamed in place by 0033.
enum OpportunityStage {
  PROSPECTING
  COST_STUDY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

/// Package 3 · P3-4: how a revision is priced (ADR-03 §4-4).
enum PricingMode {
  PER_LINE
  LUMP_SUM
}

/// CRM Phase 1 (Step 3): a direct sale or a tender. A tender adds a close date
/// (mandatory) and the bid-bond particulars on the opportunity itself.
enum OpportunityType {
  DIRECT
  TENDER
}

/// CRM Phase 1 · Step 5: the kinds of communication-log entry.
enum ActivityType {
  NOTE
  CALL
  MEETING
}

/// CRM Phase 1 · Step 5: the life of a follow-up task. No re-opening: a finished or
/// cancelled task stays so, and a new one is created instead.
enum FollowUpTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum ItemCategory {
  MODULE
  INVERTER
  MOUNTING
  CABLE
  BOS // balance of system
  SPARE
  SERVICE
}

// CRM Phase 1 · Step 4 (§9 status map): مسودة ← بانتظار الاعتماد ← معتمد ← مُرسل ←
// مقبول | مرفوض (by the customer) | منتهي الصلاحية | مُستبدَل بنسخة أحدث. Used by
// Proposal.status (a mirror of its current revision) and ProposalRevision.status;
// SUPERSEDED only ever appears on a revision. The four new values are added by
// migration 0026 and first used by 0027 (Postgres cannot use a value in the
// transaction that adds it).
enum ProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

// Where a proposal line's cost came from (CRM Step 4, spec 4.3): the last accepted
// goods receipt, the last approved purchase order, the catalogue cost (no date),
// or a manual change with a recorded reason.
enum CostSource {
  GRN
  PO
  CATALOGUE
  MANUAL
}

enum ContractType {
  EPC
  PPA
  OM
  LEASE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
  CANCELLED
}

enum MilestoneTriggerType {
  DATE
  PROGRESS
  EVENT
}

enum MilestoneStatus {
  PENDING
  VERIFIED
  INVOICED
}

// ─── Finance & ZATCA (W3) ───────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TaxType {
  VAT_STANDARD
  VAT_ZERO
  VAT_EXEMPT
  REVERSE_CHARGE
  WITHHOLDING
}

enum InvoiceType {
  MILESTONE
  SETTLEMENT
  SERVICE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CLEARED
  PAID
  CANCELLED
}

// ZATCA invoice transaction type: standard (B2B, cleared) vs simplified (B2C, reported).
enum SubmissionMode {
  CLEARANCE
  REPORTING
}

enum AuthorityStatus {
  PENDING
  CLEARED
  REPORTED
  REJECTED
}

enum RetentionStatus {
  WITHHELD
  RELEASED
}

// ─── Shared kernel (W0) ─────────────────────────────────────────────────────

model Organization {
  id                   String   @id @default(cuid())
  legalNameAr          String
  legalNameEn          String
  vatNumber            String?
  crNumber             String?
  addressAr            String?
  addressEn            String?
  phone                String?
  email                String?
  website              String?
  logoDataUrl          String?  @db.Text
  baseCurrency         String   @default("SAR")
  isTenantRoot         Boolean  @default(true)
  parentOrganizationId String?
  parent               Organization?  @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id])
  children             Organization[] @relation("OrgHierarchy")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users               User[]
  roles               Role[]
  customers           Customer[]
  leads               Lead[]
  opportunities       Opportunity[]
  items               Item[]
  workItems           WorkItem[]
  pricingSchemes      PricingScheme[]
  designVersions      DesignVersion[]
  proposals           Proposal[]
  contracts           Contract[]
  numberingSequences  NumberingSequence[]
  auditLogs           AuditLog[]
  accounts            Account[]
  taxCodes            TaxCode[]
  invoices            Invoice[]
  journalEntries      JournalEntry[]
  retentionEntries    RetentionEntry[]
  vendors             Vendor[]
  projects            Project[]
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]
  serialUnits         SerialUnit[]
  projectCostEntries  ProjectCostEntry[]
  vendorBills         VendorBill[]
  changeOrders        ChangeOrder[]
  subcontracts        SubcontractAgreement[]
  progressClaims      ProgressClaim[]
  locations           Location[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  assets              Asset[]
  workOrders          WorkOrder[]
  maintenancePlans    MaintenancePlan[]
  telemetryReadings   TelemetryReading[]
  performanceAlerts   PerformanceAlert[]
  ppaTerms            PpaTerm[]
  settlementRuns      SettlementRun[]
  warrantyClaims      WarrantyClaim[]
  paymentReceipts     PaymentReceipt[]
  timesheets          Timesheet[]
  accountMappings     AccountMapping[]
  vendorPayments      VendorPayment[]
  fiscalYears         FiscalYear[]
  fiscalPeriods       FiscalPeriod[]
  attachments         Attachment[]
  notifications       Notification[]
  approvalRules       ApprovalRule[]
  approvalRequests    ApprovalRequest[]
  eInvoiceDocuments   EInvoiceDocument[]
  // M4 — the workflow engine, and the pieces the matrix was missing.
  wfDefinitions       WfDefinition[]
  wfInstances         WfInstance[]
  domainEvents        DomainEvent[]
  departments         Department[]
  approvalDelegations ApprovalDelegation[]
  requisitions        PurchaseRequisition[]
  projectCommitments  ProjectCommitment[]
  threeWayMatches     ThreeWayMatch[]
  // CRM Phase 1 (Step 2)
  customerContacts    CustomerContact[]
  customerMergeLogs   CustomerMergeLog[]
  orgSettings         OrgSetting[]
  lossReasons         LossReason[]
  // CRM Phase 1 (Step 5)
  activities          Activity[]
  followUpTasks       FollowUpTask[]
  // ADR-02 (P1-7): per-user exceptions to the roles.
  userPermissionOverrides UserPermissionOverride[]

  @@index([parentOrganizationId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  nameAr         String
  nameEn         String
  // Flat list of permission keys, e.g. ["crm.lead.read", "commercial.contract.write"].
  permissions    String[]
  users          User[]
  // CRM Phase 1: users who hold this role *in addition to* their primary one
  // (User.roleId). The primary role still drives display and routing defaults.
  userRoles      UserRole[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  approvalRuleSteps ApprovalRuleStep[]
  approvalSteps     ApprovalStep[]
  wfInstances       WfInstance[]       @relation("WfAssigneeRole")

  @@unique([organizationId, key])
  @@index([organizationId])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String   @unique
  passwordHash   String
  nameAr         String
  nameEn         String
  locale         Locale   @default(AR)
  roleId         String
  role           Role     @relation(fields: [roleId], references: [id])
  // M4: which department this person belongs to. Optional — the matrix treats
  // a user with no department as covered only by organization-wide rules.
  departmentId   String?
  department     Department? @relation("DeptMembers", fields: [departmentId], references: [id])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownedLeads         Lead[]        @relation("LeadOwner")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  verifiedMilestones ContractMilestone[] @relation("MilestoneVerifier")
  assignedWorkOrders WorkOrder[]   @relation("WoAssignee")
  timesheets         Timesheet[]
  attachments        Attachment[]
  notifications      Notification[]
  raisedApprovals    ApprovalRequest[] @relation("ApprovalRaiser")
  decidedApprovals   ApprovalStep[]    @relation("ApprovalDecider")
  managedDepartments  Department[]         @relation("DeptManager")
  delegationsGiven    ApprovalDelegation[] @relation("DelegationFrom")
  delegationsReceived ApprovalDelegation[] @relation("DelegationTo")
  delegationsCreated  ApprovalDelegation[] @relation("DelegationCreator")
  wfHistory           WfHistory[]          @relation("WfHistoryActor")
  requisitions        PurchaseRequisition[] @relation("PrRequester")
  // CRM Phase 1: roles held in addition to the primary `roleId`.
  extraRoles          UserRole[]
  // CRM Phase 1 · Step 4: proposal revisions this person created.
  proposalRevisionsCreated ProposalRevision[] @relation("ProposalRevisionCreator")
  // CRM Phase 1 · Step 5: the communication log and the follow-up tasks.
  activitiesCreated      Activity[]     @relation("ActivityCreator")
  assignedFollowUpTasks  FollowUpTask[] @relation("TaskAssignee")
  followUpTasksCreated   FollowUpTask[] @relation("TaskCreator")
  followUpTasksCompleted FollowUpTask[] @relation("TaskCompleter")
  // ADR-02 (P1-7): GRANT / DENY exceptions on top of the roles.
  permissionOverrides    UserPermissionOverride[]

  @@index([organizationId])
  @@index([organizationId, departmentId])
}

/// CRM Phase 1: a secondary role for a user. `User.roleId` stays the primary
/// role; a user's effective permissions are the union over primary + these.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([roleId])
}

/// ADR-02 (P1-7): whether a per-user exception adds a key or takes it away.
enum PermissionEffect {
  GRANT
  DENY
}

/// ADR-02 (P1-7): a per-user exception to the roles. A user's effective
/// permissions are (union of the primary and extra roles' keys ∪ GRANT) − DENY,
/// computed by `effectivePermissions` in @npi/shared and nowhere else. One row
/// per (user, key): a key is either granted or denied, never both. The set is
/// replaced as a whole by PUT /admin/users/:id/permissions, audited in the same
/// transaction.
model UserPermissionOverride {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission     String
  effect         PermissionEffect
  reason         String?
  // The administrator who saved it. No relation, like AuditLog.actorId: the
  // row keeps saying who even after that account is gone.
  createdById    String?
  createdAt      DateTime         @default(now())

  @@unique([userId, permission])
  @@index([organizationId, permission, effect])
}

model NumberingSequence {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   String // e.g. "LEAD", "OPPORTUNITY", "PROPOSAL", "CONTRACT"
  prefix         String
  nextValue      Int    @default(1)
  fiscalYear     Int
  padding        Int    @default(5)

  @@unique([organizationId, documentType, fiscalYear])
}

// Append-only. Never updated or deleted — corrections are new rows.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  // Restrict (not Cascade): deleting an Organization must never erase the
  // audit trail — statutory records outlive tenant rows.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId        String?
  entityType     String
  entityId       String
  action         String // CREATE | UPDATE | DELETE | LOGIN | CONVERT | VERIFY ...
  beforeJson     Json?
  afterJson      Json?
  ip             String?
  occurredAt     DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, occurredAt])
}

// ─── Commercial slice (W1: Sell & Contract) ─────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String
  nameEn         String
  customerType   CustomerType @default(CI)
  vatNumber      String?
  crNumber       String?
  creditTermsDays Int     @default(0)
  phone          String?
  email          String?
  // CRM Phase 1 (Step 2) — unified customer record.
  entityKind     CustomerEntityKind @default(COMPANY)
  /// Canonical `+9665xxxxxxxx` (normalizeSaudiMobile). `phone` stays free text.
  mobile         String?
  /// nameAr after normalizeArabicName — what duplicate matching compares.
  nameNormalized String?
  /// Set on the record that was merged AWAY. The row is never deleted: its
  /// CUS-xxxxx code stays reserved and old links keep resolving.
  mergedIntoId   String?
  mergedInto     Customer?  @relation("CustomerMerge", fields: [mergedIntoId], references: [id])
  mergedFrom     Customer[] @relation("CustomerMerge")
  mergedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leads          Lead[]
  opportunities  Opportunity[]
  contracts      Contract[]
  invoices       Invoice[]
  contacts       CustomerContact[]
  // CRM Phase 1 · Step 5
  activities     Activity[]
  followUpTasks  FollowUpTask[]

  @@unique([organizationId, code])
  @@index([organizationId])
  // Non-unique here on purpose: uniqueness is the PARTIAL indexes of migration
  // 0023 (Prisma cannot express a WHERE), applied once duplicates are merged.
  @@index([organizationId, crNumber])
  @@index([organizationId, vatNumber])
  @@index([organizationId, mobile])
  @@index([organizationId, nameNormalized])
  @@index([mergedIntoId])
}

/// People at a customer. A customer has any number; at most one is primary.
model CustomerContact {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name           String
  title          String?
  phone          String?
  mobile         String?
  email          String?
  isPrimary      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // CRM Phase 1 · Step 5: entries logged against this person.
  activities     Activity[]

  @@index([organizationId, customerId])
}

/// One row per customer merged away: what moved, and the full pre-merge
/// snapshot of the merged record. There is no automatic un-merge — the way
/// back is the database backup named in `backupRef`.
model CustomerMergeLog {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  survivorId         String
  mergedId           String
  /// Rows moved per table, e.g. {"Lead":1,"Opportunity":2,"Contract":0,...}.
  movedJson          Json
  /// The merged customer, complete, as it was before the merge.
  mergedSnapshotJson Json
  /// File name of the backup the administrator took first (typed by them).
  backupRef          String
  performedById      String
  performedAt        DateTime @default(now())

  @@index([organizationId, survivorId])
}

/// Per-organization settings as key -> JSON value (first used by CRM Step 2:
/// the similarity threshold and the merge on/off switch; Steps 4 and 5 add more).
model OrgSetting {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  valueJson      Json
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
}

model Lead {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  contactName    String
  companyName    String?
  source         LeadSource @default(DIRECT)
  status         LeadStatus @default(NEGOTIATING)
  estimatedKwp   Decimal? @db.Decimal(12, 3)
  phone          String?
  email          String?
  notes          String?
  // Package 3 · P3-1 (ADR-03 §4-1, migration 0032): where the customer is and
  // where the plant will be built, the rejection reason, and when the
  // negotiation status last changed.
  address        String?
  siteLocation   String?
  siteLat        Decimal? @db.Decimal(9, 6)
  siteLng        Decimal? @db.Decimal(9, 6)
  rejectionReasonId String?
  rejectionReason   LossReason? @relation(fields: [rejectionReasonId], references: [id], onDelete: Restrict)
  rejectionNotes String?
  statusChangedAt DateTime?
  ownerId        String?
  owner          User?    @relation("LeadOwner", fields: [ownerId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  convertedOpportunityId String? @unique
  convertedOpportunity   Opportunity? @relation("LeadConversion", fields: [convertedOpportunityId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([rejectionReasonId])
}

model Opportunity {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  stage          OpportunityStage @default(PROSPECTING)
  estimatedKwp   Decimal? @db.Decimal(12, 3)
  estimatedValue Decimal? @db.Decimal(18, 2)
  currency       String   @default("SAR")
  expectedCloseDate DateTime?
  ownerId        String?
  owner          User?    @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // CRM Phase 1 · Step 3 (migration 0024) ─────────────────────────────────────
  opportunityType OpportunityType @default(DIRECT)
  /// Tender fields: only meaningful when opportunityType = TENDER (the service
  /// clears them for a DIRECT opportunity). tenderCloseDate is mandatory then.
  tenderReference String?
  tenderCloseDate DateTime?
  bidBondAmount   Decimal? @db.Decimal(18, 2)
  bidBondBank     String?
  bidBondExpiry   DateTime?
  bidBondReference String?
  /// Mandatory (service-enforced) when stage = LOST; the reason is never deleted.
  lossReasonId   String?
  lossReason     LossReason? @relation(fields: [lossReasonId], references: [id], onDelete: Restrict)
  lossNotes      String?
  /// The moment the opportunity became WON or LOST.
  closedAt       DateTime?
  /// The last stage change — the funnel's "age in stage".
  stageChangedAt DateTime?

  sourceLead     Lead?    @relation("LeadConversion")
  designVersions DesignVersion[]
  proposals      Proposal[]
  contracts      Contract[]
  // CRM Phase 1 · Step 5
  activities     Activity[]
  followUpTasks  FollowUpTask[]

  @@unique([organizationId, code])
  @@index([organizationId, stage])
  @@index([organizationId, opportunityType])
  @@index([lossReasonId])
}

/// CRM Phase 1 · Step 3: the editable list of reasons an opportunity is lost.
/// Never deleted once used — switched off with isActive = false.
model LossReason {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nameAr         String
  nameEn         String
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunities  Opportunity[]
  rejectedLeads  Lead[]

  @@unique([organizationId, nameAr])
  @@index([organizationId, isActive, sortOrder])
}

model Item {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku            String
  nameAr         String
  nameEn         String
  itemCategory   ItemCategory
  uom            String   @default("unit")
  isSerialised   Boolean  @default(false)
  unitCost       Decimal  @default(0) @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bomLines       BomLine[]
  workItems      WorkItem[]
  poLines        PurchaseOrderLine[]
  prLines        PurchaseRequisitionLine[]
  serialUnits    SerialUnit[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  workOrderParts WorkOrderPart[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

/// Package 3 · P3-3 (ADR-03 §4-3): what a project's estimated budget is made
/// of — materials, labour, equipment rental, subcontract, expenses, financing.
/// Not a stock item: a MATERIAL work item may point at the stock item it
/// stands for (and then takes its latest cost from it), the others never do.
enum WorkItemKind {
  MATERIAL
  LABOUR
  EQUIPMENT
  SUBCONTRACT
  EXPENSE
  FINANCING
}

/// بند مشروع — one row of the company's list of project work items (ADR-03 §4-3).
/// Never deleted once used: switching it off hides it from new budgets.
model WorkItem {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code            String
  nameAr          String
  nameEn          String
  kind            WorkItemKind
  uom             String   @default("unit")
  /// Cost per unit offered when the item is added to a budget (a cost field:
  /// redacted for a caller without finance.costs.view).
  defaultUnitCost Decimal  @default(0) @db.Decimal(18, 2)
  itemId          String?
  item            Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bomLines        BomLine[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, sortOrder])
  @@index([itemId])
}

model PricingScheme {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String
  nameEn         String
  marginPct      Decimal  @default(0) @db.Decimal(6, 3)
  currency       String   @default("SAR")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  revisions      ProposalRevision[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model DesignVersion {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  sourceTool     String   @default("manual") // aurora | pvsyst | helioscope | opensolar | manual
  externalRef    String?
  versionNo      Int      @default(1)
  capacityKwp    Decimal  @default(0) @db.Decimal(12, 3)
  expectedAnnualKwh Decimal @default(0) @db.Decimal(18, 2)
  importedAt     DateTime @default(now())

  revisions      ProposalRevision[]

  @@index([organizationId])
  @@index([opportunityId])
}

model Proposal {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  status         ProposalStatus @default(DRAFT)
  currency       String   @default("SAR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  revisions      ProposalRevision[]
  contracts      Contract[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model ProposalRevision {
  id             String   @id @default(cuid())
  proposalId     String
  proposal       Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revisionNo     Int
  designVersionId String?
  designVersion  DesignVersion? @relation(fields: [designVersionId], references: [id])
  pricingSchemeId String?
  pricingScheme  PricingScheme? @relation(fields: [pricingSchemeId], references: [id])
  subtotal       Decimal  @default(0) @db.Decimal(18, 2)
  marginAmount   Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal  @default(0) @db.Decimal(18, 2)
  status         ProposalStatus @default(DRAFT)
  isWinning      Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Package 3 · P3-4 (ADR-03 §4-4): the revision IS the estimated budget.
  // LUMP_SUM: the lines carry cost only and `sellingTotal` is the price;
  // PER_LINE: every line carries its selling price (all revisions before 0035).
  pricingMode       PricingMode @default(PER_LINE)
  sellingTotal      Decimal?  @db.Decimal(18, 2)
  /// Risk contingency on the estimated cost, as a percentage (5 = 5 %) and the
  /// amount it gives. Both are cost fields.
  contingencyPct    Decimal   @default(0) @db.Decimal(6, 3)
  contingencyAmount Decimal   @default(0) @db.Decimal(18, 2)
  riskNotes         String?

  // CRM Phase 1 · Step 4 (spec 4.3). All nullable: a revision written before
  // this step has none of them and keeps its old meaning.
  /// The last day the offer is valid (UTC midnight of a Riyadh calendar day).
  validUntil     DateTime?
  submittedAt    DateTime?
  approvedAt     DateTime?
  sentAt         DateTime?
  /// The moment the revision stopped being current: accepted, rejected by the
  /// customer, expired or superseded.
  closedAt       DateTime?
  /// The newer revision that took its place (set with status SUPERSEDED).
  supersededById String?
  createdById    String?
  createdBy      User?    @relation("ProposalRevisionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  bomLines       BomLine[]
  contract       Contract?

  @@unique([proposalId, revisionNo])
  @@index([status, validUntil])
}

model BomLine {
  id                 String @id @default(cuid())
  proposalRevisionId String
  proposalRevision   ProposalRevision @relation(fields: [proposalRevisionId], references: [id], onDelete: Cascade)
  /// Optional since Package 3 (migration 0035): a budget line is a work item,
  /// which may or may not be a stock item. A CHECK keeps at least one of the two.
  itemId             String?
  item               Item?  @relation(fields: [itemId], references: [id])
  /// Package 3 · P3-4 (ADR-03 §4-4): the project work item this line is.
  workItemId         String?
  workItem           WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  /// The line's own wording and unit (default: the work item's / item's).
  description        String?
  uom                String?
  qty                Decimal @default(1) @db.Decimal(14, 3)
  unitPrice          Decimal @default(0) @db.Decimal(18, 2)
  isAdder            Boolean @default(false)
  lineTotal          Decimal @default(0) @db.Decimal(18, 2)

  // CRM Phase 1 · Step 4 (spec 4.3). From Step 4 on a new revision keeps the COST
  // here and the SELLING price in unitPrice; a line without unitCost is a pre-Step-4
  // line whose unitPrice is the cost base. originalUnitCost is what the system
  // fetched; unitCost differs from it only after a manual change (with its reason).
  unitCost           Decimal? @db.Decimal(18, 2)
  originalUnitCost   Decimal? @db.Decimal(18, 2)
  costSource         CostSource?
  /// When that cost was incurred (receipt / order date); null for a catalogue cost.
  costDate           DateTime?
  costAgeDays        Int?
  costOverrideReason String?
  costOverriddenAt   DateTime?
  costOverriddenById String?

  @@index([proposalRevisionId])
  @@index([workItemId])
}

model Contract {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  opportunityId      String?
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id])
  proposalId         String?
  proposal           Proposal? @relation(fields: [proposalId], references: [id])
  proposalRevisionId String?  @unique
  proposalRevision   ProposalRevision? @relation(fields: [proposalRevisionId], references: [id])
  contractType       ContractType @default(EPC)
  status             ContractStatus @default(DRAFT)
  startDate          DateTime?
  endDate            DateTime?
  currency           String   @default("SAR")
  totalValue         Decimal  @default(0) @db.Decimal(18, 2)
  retentionPct       Decimal  @default(0) @db.Decimal(6, 3)
  advancePct         Decimal  @default(0) @db.Decimal(6, 3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  milestones         ContractMilestone[]
  invoices           Invoice[]
  retentionEntries   RetentionEntry[]
  project            Project?
  changeOrders       ChangeOrder[]
  ppaTerm            PpaTerm?

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([customerId])
}

model ContractMilestone {
  id             String   @id @default(cuid())
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sequence       Int
  descriptionAr  String
  descriptionEn  String
  triggerType    MilestoneTriggerType @default(PROGRESS)
  amount         Decimal  @default(0) @db.Decimal(18, 2)
  dueDate        DateTime?
  status         MilestoneStatus @default(PENDING)
  verifiedAt     DateTime?
  verifiedById   String?
  verifiedBy     User?    @relation("MilestoneVerifier", fields: [verifiedById], references: [id])
  invoiceId      String?  @unique
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])

  @@unique([contractId, sequence])
  @@index([contractId])
}

// ─── Finance & ZATCA (W3) ───────────────────────────────────────────────────

model Account {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String
  nameEn         String
  accountType    AccountType
  createdAt      DateTime @default(now())

  journalLines   JournalLine[]
  mappings       AccountMapping[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model TaxCode {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String
  nameEn         String
  taxType        TaxType
  rate           Decimal  @default(0) @db.Decimal(6, 3) // e.g. 15.000 for standard VAT
  createdAt      DateTime @default(now())

  invoiceLines   InvoiceLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  // Restrict: issued (ZATCA) invoices are legally retained — see AuditLog.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code           String
  invoiceType    InvoiceType @default(MILESTONE)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  contractId     String?
  contract       Contract? @relation(fields: [contractId], references: [id])
  issueDate      DateTime @default(now())
  currency       String   @default("SAR")
  subtotal       Decimal  @default(0) @db.Decimal(18, 2) // net of VAT, before retention
  vatAmount      Decimal  @default(0) @db.Decimal(18, 2)
  retentionAmount Decimal @default(0) @db.Decimal(18, 2) // withheld from this invoice
  total          Decimal  @default(0) @db.Decimal(18, 2) // subtotal + vat (gross billed)
  netPayable     Decimal  @default(0) @db.Decimal(18, 2) // total - retention (amount due now)
  status         InvoiceStatus @default(DRAFT)
  // Credit notes (ZATCA InvoiceTypeCode 381) point back at the invoice they
  // correct. The original is never edited — a cleared e-invoice is a statutory
  // record, so a correction is always a new, separately-reported document.
  creditedInvoiceId String?
  creditedInvoice   Invoice? @relation("InvoiceCredits", fields: [creditedInvoiceId], references: [id])
  creditNotes       Invoice[] @relation("InvoiceCredits")
  creditReason      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines          InvoiceLine[]
  eInvoice       EInvoiceDocument?
  milestone      ContractMilestone?
  journalEntries JournalEntry[]
  retentionEntry RetentionEntry?
  settlementRun  SettlementRun?
  payments       PaymentReceipt[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([creditedInvoiceId])
  @@index([customerId])
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  descriptionAr  String
  descriptionEn  String
  qty            Decimal  @default(1) @db.Decimal(14, 3)
  unitPrice      Decimal  @default(0) @db.Decimal(18, 2)
  taxCodeId      String?
  taxCode        TaxCode? @relation(fields: [taxCodeId], references: [id])
  lineSubtotal   Decimal  @default(0) @db.Decimal(18, 2)
  vatAmount      Decimal  @default(0) @db.Decimal(18, 2)

  @@index([invoiceId])
}

// ZATCA Phase 2 compliance record — append-only. Holds the chained hash, the
// QR TLV, the cryptographic stamp and the authority response.
model EInvoiceDocument {
  id                 String   @id @default(cuid())
  invoiceId          String   @unique
  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Denormalised from Invoice deliberately. The chain is per organization, but
  // a database constraint cannot span a join — so as long as the tenant lived
  // only on the far side of `invoiceId`, nothing below the application could
  // state the rule that two documents may not claim one predecessor. With the
  // column here, @@unique states it, and every future write path — an import,
  // a data migration, a manual repair — inherits the rule instead of having to
  // remember it. Restrict, like Invoice and JournalEntry: a ZATCA document is
  // a statutory record and an organization row cannot delete it out from under
  // the chain.
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uuid               String   @unique
  invoiceHash        String   // base64 SHA-256 of the canonical XML
  previousInvoiceHash String  // PIH — chains invoices per organization
  qrTlv              String   // base64 TLV (ZATCA QR)
  cryptographicStamp String   // base64 ECDSA signature over the hash
  publicKey          String   // base64 signing public key (SPKI)
  xmlPayload         String   // the UBL 2.1 XML document
  submissionMode     SubmissionMode @default(CLEARANCE)
  authorityStatus    AuthorityStatus @default(PENDING)
  authorityResponseRef String?
  isSimulated        Boolean  @default(true) // true until a real ZATCA CSID is wired in
  submittedAt        DateTime @default(now())

  // The tail lookup that every issue performs, inside a Serializable window:
  // without this it is a sequential scan of every document in the table joined
  // back to Invoice and sorted. Measured at 20k documents per organization,
  // 59.3ms became 0.075ms — and the time saved is time the isolation window is
  // not held open, which is what drives the retry rate.
  @@index([organizationId, submittedAt])
  // The structural form of "the chain does not fork". Scoped to the
  // organization because every chain legitimately begins at the same
  // GENESIS_PIH, so a global unique on previousInvoiceHash would collide
  // between tenants on their very first invoice.
  @@unique([organizationId, previousInvoiceHash])
}

model JournalEntry {
  id             String   @id @default(cuid())
  organizationId String
  // Restrict: the general ledger is a statutory record — see AuditLog.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  postingDate    DateTime @default(now())
  sourceType     String   // "Invoice", "Payment", ...
  sourceId       String
  memo           String?
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  // Project dimension: set on every entry that belongs to one project, so the
  // WIP balance can be read per project without joining back through the
  // source document. Cost recognition depends on it.
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  isReversal     Boolean  @default(false)
  reversedEntryId String?
  createdAt      DateTime @default(now())

  lines          JournalLine[]

  @@index([organizationId, postingDate])
  @@index([sourceType, sourceId])
  @@index([projectId])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  currency       String   @default("SAR")

  @@index([journalEntryId])
  @@index([accountId])
}

model RetentionEntry {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id])
  invoiceId      String   @unique
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  withheldAmount Decimal  @db.Decimal(18, 2)
  // Retention reversed by credit notes raised against this invoice. A credit
  // note splits between AR and retention in the invoice's own proportion, and
  // the retention half is booked to the ledger — so it has to be recorded here
  // too, or the entry keeps claiming money the ledger has already given back.
  creditedAmount Decimal  @default(0) @db.Decimal(18, 2)
  releaseDueDate DateTime?
  status         RetentionStatus @default(WITHHELD)
  releasedInvoiceId String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([contractId])
}

// ─── Projects & Procurement (W2: Deliver & Cost) ────────────────────────────

enum ProjectStage {
  PLANNING
  PROCUREMENT
  EXECUTION
  COMMISSIONING
  CLOSED
}

enum VendorType {
  SUPPLIER
  SUBCONTRACTOR
  OEM
  SERVICE
}

// M4 §7: the PO map gained the two states it was actually missing —
// PENDING_APPROVAL (it is in a signature chain, not sitting in someone's
// drafts) and SENT (approved internally is not the same as placed with the
// vendor, and only the second is a commitment the vendor knows about).
enum PoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

// M4 §7: a receipt used to have no state at all — goods were received and
// accepted in the same instant, so "arrived but not yet inspected" could not
// be expressed and a rejected delivery had nowhere to live.
enum GrnStatus {
  DRAFT
  INSPECTED
  ACCEPTED
  PARTIALLY_REJECTED
}

enum SerialState {
  IN_STOCK
  INSTALLED
  FAULTY
  RETURNED
  SCRAPPED
}

enum CostType {
  MATERIAL
  LABOUR
  SUBCONTRACT
  EQUIPMENT
  OVERHEAD
}

// M4 §7: مسجَّلة ← مطابقة ثلاثياً ← معتمدة ← مجدولة للدفع ← مدفوعة.
// The journal moved with the states: a bill used to be created already POSTED,
// so recording a supplier's paperwork and accepting the liability were one
// irreversible act. The ledger entry now waits for APPROVED.
// POSTED is retained, unreachable by new code, so rows written before this
// migration keep meaning what they meant — see BILL_STATUSES_WITH_AP_BALANCE.
enum BillStatus {
  DRAFT
  MATCHED
  APPROVED
  SCHEDULED
  POSTED
  PAID
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String
  nameEn         String
  vendorType     VendorType @default(SUPPLIER)
  vatNumber      String?
  crNumber       String?
  phone          String?
  email          String?
  isManufacturer Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  serialUnits    SerialUnit[]
  vendorBills    VendorBill[]
  subcontracts   SubcontractAgreement[]
  warrantyClaims WarrantyClaim[]
  payments       VendorPayment[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// CRM Phase 1 · Step 5 (migration 0028): what happened with a customer — a note, a
/// call, a meeting. Always tied to a customer, optionally to an opportunity, a
/// project and the person at the customer. Edited by its author only and never
/// deleted: the communication log is historical evidence, like the audit trail.
/// Files are `Attachment` rows of entityType ACTIVITY.
model Activity {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activityType   ActivityType
  /// When it happened (not when it was typed in).
  occurredAt     DateTime
  body           String   @db.Text
  createdById    String?
  createdBy      User?    @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, customerId, occurredAt(sort: Desc)])
  @@index([organizationId, opportunityId])
  @@index([createdById])
}

/// CRM Phase 1 · Step 5 (migration 0028): what must happen next. `dueAt` is a DAY
/// (UTC midnight of its Riyadh date, the convention of a proposal's validUntil); a
/// task is late once a Riyadh day has begun after it. Shared by the team: anyone who
/// may edit customers completes, cancels or re-assigns it. Reminders and the overdue
/// notice are in-system notifications, each sent once (`reminderSentAt`,
/// `overdueNotifiedAt`).
model FollowUpTask {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// TSK-00001 … from the FOLLOWUP_TASK numbering sequence.
  code           String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title          String
  details        String?  @db.Text
  dueAt          DateTime
  remindAt       DateTime?
  assigneeId     String
  assignee       User     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  status         FollowUpTaskStatus @default(OPEN)
  completedAt    DateTime?
  completedById  String?
  completedBy    User?    @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  cancelReason   String?
  reminderSentAt DateTime?
  overdueNotifiedAt DateTime?
  createdById    String?
  createdBy      User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, assigneeId, status, dueAt])
  @@index([organizationId, customerId, status])
  @@index([organizationId, opportunityId])
  @@index([status, remindAt])
  @@index([status, dueAt])
}

// PRJ-01/02/03: the execution container born from a contract.
model Project {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  contractId       String   @unique
  contract         Contract @relation(fields: [contractId], references: [id])
  nameAr           String
  nameEn           String
  stage            ProjectStage @default(PLANNING)
  siteRef          String?
  capacityKwp      Decimal? @db.Decimal(12, 3)
  plannedStart     DateTime?
  plannedEnd       DateTime?
  projectManagerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wbsElements    WbsElement[]
  purchaseOrders PurchaseOrder[]
  costEntries    ProjectCostEntry[]
  serialUnits    SerialUnit[]
  changeOrders   ChangeOrder[]
  subcontracts   SubcontractAgreement[]
  locations      Location[]
  assets         Asset[]
  workOrders     WorkOrder[]
  maintenancePlans MaintenancePlan[]
  ppaTerms       PpaTerm[]
  journalEntries JournalEntry[]
  requisitions   PurchaseRequisition[]
  commitments    ProjectCommitment[]
  // CRM Phase 1 · Step 5 (optional link; the screens do not offer it yet)
  activities     Activity[]
  followUpTasks  FollowUpTask[]

  @@unique([organizationId, code])
  @@index([organizationId, stage])
}

// PRJ-02/04: flat WBS carrying the budget (parent link reserved for deep WBS).
model WbsElement {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentWbsId  String?
  code         String
  nameAr       String
  nameEn       String
  budgetAmount Decimal @default(0) @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  poLines      PurchaseOrderLine[]
  prLines      PurchaseRequisitionLine[]
  costEntries  ProjectCostEntry[]
  commitments  ProjectCommitment[]
  changeOrders ChangeOrder[]
  subcontracts SubcontractAgreement[]

  @@unique([projectId, code])
  @@index([projectId])
}

// SCM-01/02: committed cost against the project.
model PurchaseOrder {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  status         PoStatus @default(DRAFT)
  currency       String   @default("SAR")
  subtotal       Decimal  @default(0) @db.Decimal(18, 2)
  vatAmount      Decimal  @default(0) @db.Decimal(18, 2)
  total          Decimal  @default(0) @db.Decimal(18, 2)
  approvedAt     DateTime?
  approvedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines          PurchaseOrderLine[]
  goodsReceipts  GoodsReceipt[]
  vendorBills    VendorBill[]
  requisition    PurchaseRequisition?
  threeWayMatches ThreeWayMatch[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([projectId])
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item    @relation(fields: [itemId], references: [id])
  wbsElementId    String?
  wbsElement      WbsElement? @relation(fields: [wbsElementId], references: [id])
  qty             Decimal @default(1) @db.Decimal(14, 3)
  unitPrice       Decimal @default(0) @db.Decimal(18, 2)
  lineTotal       Decimal @default(0) @db.Decimal(18, 2)
  receivedQty     Decimal @default(0) @db.Decimal(14, 3)

  grnLines        GoodsReceiptLine[]

  @@index([purchaseOrderId])
}

// SCM-01: receipt against a PO; the registration point for serials (SCM-05).
model GoodsReceipt {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  purchaseOrderId String
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  // New receipts start as DRAFT and only move stock on acceptance. Rows that
  // existed before this migration are backfilled to ACCEPTED — their stock
  // moved long ago, and re-deriving it would double it.
  status         GrnStatus @default(DRAFT)
  receivedAt     DateTime @default(now())
  receivedById   String?
  inspectedAt    DateTime?
  inspectedById  String?
  /// Why the delivery was not accepted in full. Required by the flow before a
  /// receipt may reach PARTIALLY_REJECTED — a rejection with no stated reason
  /// is a dispute with the vendor nobody can reconstruct later.
  rejectionNote  String?
  notes          String?

  lines          GoodsReceiptLine[]
  serialUnits    SerialUnit[]
  vendorBills    VendorBill[]
  threeWayMatches ThreeWayMatch[]

  @@unique([organizationId, code])
  @@index([purchaseOrderId])
  @@index([organizationId, status])
}

model GoodsReceiptLine {
  id                  String @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  qty                 Decimal @default(0) @db.Decimal(14, 3)
  /// M4: serial numbers are read off the cartons when the delivery arrives,
  /// but stock only exists once the receipt is accepted. They are stored here
  /// in between — on the row, not in process memory, because a receipt left
  /// overnight must survive a restart.
  serials             String[]
  batchNo             String?

  @@index([goodsReceiptId])
}

// SCM-05 / AST-01: the procurement↔operations joint. An entity, not a field.
model SerialUnit {
  id                   String   @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId               String
  item                 Item     @relation(fields: [itemId], references: [id])
  serialNo             String
  batchNo              String?
  manufacturerVendorId String?
  manufacturerVendor   Vendor?  @relation(fields: [manufacturerVendorId], references: [id])
  goodsReceiptId       String?
  goodsReceipt         GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  projectId            String?
  project              Project? @relation(fields: [projectId], references: [id])
  currentState         SerialState @default(IN_STOCK)
  locationId           String?
  location             Location? @relation(fields: [locationId], references: [id])
  installedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  stockMovements       StockMovement[]
  asset                Asset?
  warrantyClaims       WarrantyClaim[] @relation("ClaimedSerial")
  replacementFor       WarrantyClaim?  @relation("ReplacementSerial")

  @@unique([organizationId, itemId, serialNo])
  @@index([organizationId, currentState])
  @@index([projectId])
}

// PRJ-03: append-only actual-cost ledger. Corrections are reversing rows.
model ProjectCostEntry {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  wbsElementId   String?
  wbsElement     WbsElement? @relation(fields: [wbsElementId], references: [id])
  costType       CostType
  sourceType     String   // "GoodsReceipt", "VendorBill", "WorkOrder", "Reversal"
  sourceId       String
  amount         Decimal  @db.Decimal(18, 2) // negative only on reversing rows
  memo           String?
  postedAt       DateTime @default(now())

  @@index([organizationId, projectId])
  @@index([sourceType, sourceId])
}

// ─── W2 remainder: change orders, subcontracts, multi-location stock ────────

enum ChangeOrderStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum SubcontractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
}

enum ClaimStatus {
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}

enum LocationType {
  WAREHOUSE
  LAYDOWN_YARD
  SITE
  VAN
}

// PRJ-06: variations with cost impact; approval adjusts the contract value
// (and optionally a WBS budget), which flows into POC and profitability.
model ChangeOrder {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  wbsElementId   String?
  wbsElement     WbsElement? @relation(fields: [wbsElementId], references: [id])
  descriptionAr  String
  descriptionEn  String
  amountDelta    Decimal  @db.Decimal(18, 2) // signed: additions +, omissions −
  scheduleImpactDays Int  @default(0)
  status         ChangeOrderStatus @default(DRAFT)
  approvedAt     DateTime?
  approvedById   String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, code])
  @@index([contractId])
}

// PRJ-07: subcontractor scope with back-to-back progress claims.
model SubcontractAgreement {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  wbsElementId   String?
  wbsElement     WbsElement? @relation(fields: [wbsElementId], references: [id])
  scopeAr        String
  scopeEn        String
  amount         Decimal  @db.Decimal(18, 2)
  retentionPct   Decimal  @default(0) @db.Decimal(6, 3)
  status         SubcontractStatus @default(ACTIVE)
  createdAt      DateTime @default(now())

  claims         ProgressClaim[]

  @@unique([organizationId, code])
  @@index([projectId])
}

// PRJ-07: المستخلص — approval posts SUBCONTRACT actuals + AP journal.
model ProgressClaim {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  agreementId    String
  agreement      SubcontractAgreement @relation(fields: [agreementId], references: [id])
  sequence       Int
  descriptionAr  String?
  descriptionEn  String?
  claimedAmount  Decimal  @db.Decimal(18, 2) // work value before VAT
  vatAmount      Decimal  @default(0) @db.Decimal(18, 2)
  retentionWithheld Decimal @default(0) @db.Decimal(18, 2)
  netPayable     Decimal  @default(0) @db.Decimal(18, 2)
  status         ClaimStatus @default(SUBMITTED)
  approvedAt     DateTime?
  approvedById   String?
  // Subcontractor retention: withheld at approval, released later into AP so it
  // is settled by the ordinary payment run (mirrors the customer-side release).
  retentionReleasedAt DateTime?
  createdAt      DateTime @default(now())

  paymentAllocations VendorPaymentAllocation[]

  @@unique([organizationId, code])
  @@unique([agreementId, sequence])
}

// SCM-04: warehouse / laydown yard / job site / technician van.
model Location {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String
  nameEn         String
  locationType   LocationType @default(WAREHOUSE)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  createdAt      DateTime @default(now())

  serialUnits    SerialUnit[]
  stockLevels    StockLevel[]
  movementsFrom  StockMovement[] @relation("MoveFrom")
  movementsTo    StockMovement[] @relation("MoveTo")

  @@unique([organizationId, code])
  @@index([organizationId])
}

// Bulk (non-serialised) stock per item per location.
model StockLevel {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id])
  locationId     String
  location       Location @relation(fields: [locationId], references: [id])
  qty            Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, itemId, locationId])
}

// Append-only movement trail: receipts, transfers, issues.
model StockMovement {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id], map: "StockMovement_item_fkey")
  serialUnitId   String?
  serialUnit     SerialUnit? @relation(fields: [serialUnitId], references: [id])
  fromLocationId String?
  fromLocation   Location? @relation("MoveFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location? @relation("MoveTo", fields: [toLocationId], references: [id])
  qty            Decimal  @default(1) @db.Decimal(14, 3)
  movementType   String   // RECEIPT | TRANSFER | ISSUE
  sourceType     String?  // "GoodsReceipt", ...
  sourceId       String?
  movedAt        DateTime @default(now())

  @@index([organizationId, itemId])
  @@index([serialUnitId])
}

// ─── O&M / Field Service (W4: Operate) ─────────────────────────────────────

enum AssetType {
  PLANT
  BLOCK
  ARRAY
  STRING
  MODULE
  INVERTER
  TRANSFORMER
  TRACKER
  METER
  COMBINER
  EQUIPMENT
}

enum AssetStatus {
  OPERATING
  FAULTY
  UNDER_MAINTENANCE
  RETIRED
}

enum WoType {
  CORRECTIVE
  PREVENTIVE
  CLEANING
  INSPECTION
  COMMISSIONING
}

enum WoOrigin {
  MANUAL
  PLAN
  ALERT
  TICKET
}

enum WoPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WoStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

// AST-01: the operating register. Born automatically when a serial installs;
// PLANT roots are created per project on first install.
model Asset {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  parentAssetId  String?
  parent         Asset?   @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  children       Asset[]  @relation("AssetHierarchy")
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  assetType      AssetType @default(EQUIPMENT)
  nameAr         String
  nameEn         String
  serialUnitId   String?  @unique
  serialUnit     SerialUnit? @relation(fields: [serialUnitId], references: [id])
  status         AssetStatus @default(OPERATING)
  installDate    DateTime?
  warrantyEndDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workOrders     WorkOrder[]
  maintenancePlans MaintenancePlan[]
  telemetryReadings TelemetryReading[]
  performanceAlerts PerformanceAlert[]

  @@unique([organizationId, code])
  @@index([organizationId, assetType])
  @@index([projectId])
}

// FSM-01: corrective/preventive work orders with dispatch and lifecycle.
model WorkOrder {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  assetId        String?
  asset          Asset?   @relation(fields: [assetId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  woType         WoType   @default(CORRECTIVE)
  origin         WoOrigin @default(MANUAL)
  priority       WoPriority @default(MEDIUM)
  status         WoStatus @default(OPEN)
  titleAr        String
  titleEn        String
  description    String?
  assignedToId   String?
  assignedTo     User?    @relation("WoAssignee", fields: [assignedToId], references: [id])
  scheduledAt    DateTime?
  slaDueAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  closedAt       DateTime?
  // FSM-04: checklist results captured at completion [{label, done, note}].
  checklistJson  Json?
  maintenancePlanId String?
  maintenancePlan MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parts          WorkOrderPart[]
  alert          PerformanceAlert?
  warrantyClaims WarrantyClaim[]
  timesheets     Timesheet[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([assetId])
  @@index([assignedToId])
}

// Spare-part consumption: draws from a stock location, posts O&M cost.
model WorkOrderPart {
  id             String   @id @default(cuid())
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id])
  qty            Decimal  @default(1) @db.Decimal(14, 3)
  fromLocationId String?
  unitCost       Decimal  @default(0) @db.Decimal(18, 2)
  totalCost      Decimal  @default(0) @db.Decimal(18, 2)
  createdAt      DateTime @default(now())

  @@index([workOrderId])
}

// FSM-02: calendar-triggered plans that generate preventive work orders.
model MaintenancePlan {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String
  nameEn         String
  assetId        String?
  asset          Asset?   @relation(fields: [assetId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  intervalDays   Int      @default(90)
  nextDueAt      DateTime
  // FSM-04: checklist template items [{labelAr, labelEn, mandatory}].
  checklistTemplateJson Json?
  isActive       Boolean  @default(true)
  lastGeneratedAt DateTime?
  createdAt      DateTime @default(now())

  workOrders     WorkOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, nextDueAt])
}

// ─── Telemetry bridge (W5: Connect the plant) ──────────────────────────────

enum AlertType {
  UNDERPERFORMANCE
  OFFLINE
  COMM_LOSS
  OVERTEMP
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  WORK_ORDERED
  RESOLVED
}

// TEL-01: daily production readings per asset, append-only. The real SCADA /
// inverter-API connectors live in the separate integration service (§5.1);
// `source` marks what fed each row (SIMULATED until that service ships).
model TelemetryReading {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id])
  readingDate    DateTime // day granularity (UTC midnight)
  energyKwh      Decimal  @db.Decimal(14, 3)
  expectedKwh    Decimal? @db.Decimal(14, 3)
  performanceRatio Decimal? @db.Decimal(6, 3) // actual / expected
  source         String   @default("SIMULATED") // SIMULATED | SCADA | API
  createdAt      DateTime @default(now())

  alerts         PerformanceAlert[]

  @@unique([assetId, readingDate])
  @@index([organizationId, readingDate])
}

// TEL-03/04 + FSM-11: the metering-to-money joint — an alert that can raise
// a work order, whose closure resolves the alert.
model PerformanceAlert {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id])
  readingId      String?
  reading        TelemetryReading? @relation(fields: [readingId], references: [id])
  alertType      AlertType
  severity       AlertSeverity @default(WARNING)
  status         AlertStatus @default(OPEN)
  message        String
  ruleRef        String? // which rule fired, e.g. "PR<0.5"
  detectedAt     DateTime @default(now())
  acknowledgedById String?
  acknowledgedAt DateTime?
  workOrderId    String?  @unique
  workOrder      WorkOrder? @relation(fields: [workOrderId], references: [id])
  resolvedAt     DateTime?

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([assetId])
}

// ─── Recurring revenue (W6: PPA & settlement) ──────────────────────────────

enum BillingCycle {
  MONTHLY
  QUARTERLY
}

enum PpaStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum SettlementStatus {
  INVOICED
  CANCELLED
}

// PPA-01/02: commercial terms + tariff with annual escalation, attached to a
// PPA/O&M contract. fixedMonthlyFee covers the O&M fixed+variable case (PPA-07).
model PpaTerm {
  id                  String   @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                String
  contractId          String   @unique
  contract            Contract @relation(fields: [contractId], references: [id])
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id])
  ratePerKwh          Decimal  @db.Decimal(10, 4)
  escalationPctPerYear Decimal @default(0) @db.Decimal(6, 3)
  fixedMonthlyFee     Decimal  @default(0) @db.Decimal(18, 2)
  billingCycle        BillingCycle @default(MONTHLY)
  startDate           DateTime
  endDate             DateTime?
  status              PpaStatus @default(ACTIVE)
  createdAt           DateTime @default(now())

  settlementRuns      SettlementRun[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

// PPA-03: the per-kWh settlement — computed from telemetry readings, fully
// recomputable (inputs stored), and it produces exactly one invoice.
model SettlementRun {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  ppaTermId         String
  ppaTerm           PpaTerm  @relation(fields: [ppaTermId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  energyKwh         Decimal  @db.Decimal(14, 3)
  appliedRate       Decimal  @db.Decimal(10, 4) // after escalation
  escalationApplied Decimal  @default(0) @db.Decimal(6, 3)
  variableAmount    Decimal  @db.Decimal(18, 2)
  fixedAmount       Decimal  @default(0) @db.Decimal(18, 2)
  subtotal          Decimal  @db.Decimal(18, 2)
  status            SettlementStatus @default(INVOICED)
  invoiceId         String?  @unique
  invoice           Invoice? @relation(fields: [invoiceId], references: [id])
  computedAt        DateTime @default(now())

  @@unique([organizationId, code])
  // One settlement per PPA term per period — the DB, not the service, is what
  // ultimately prevents double-billing a period. If run cancellation is ever
  // implemented, convert this to a partial unique index (WHERE status =
  // 'INVOICED') in raw SQL.
  @@unique([ppaTermId, periodStart, periodEnd])
}

// ─── W7: warranty RMA, payments, labour time ───────────────────────────────

enum WarrantyClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REPLACED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
}

// FSM-09: the serial-to-manufacturer RMA. Replacement swaps the asset's serial
// so the operating history survives the hardware change.
model WarrantyClaim {
  id                     String   @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                   String
  serialUnitId           String
  serialUnit             SerialUnit @relation("ClaimedSerial", fields: [serialUnitId], references: [id])
  manufacturerVendorId   String?
  manufacturerVendor     Vendor?  @relation(fields: [manufacturerVendorId], references: [id])
  workOrderId            String?
  workOrder              WorkOrder? @relation(fields: [workOrderId], references: [id])
  defectAr               String
  defectEn               String
  status                 WarrantyClaimStatus @default(DRAFT)
  submittedAt            DateTime?
  resolvedAt             DateTime?
  replacementSerialUnitId String? @unique
  replacementSerialUnit  SerialUnit? @relation("ReplacementSerial", fields: [replacementSerialUnitId], references: [id])
  createdAt              DateTime @default(now())

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([serialUnitId])
}

// Customer payment against an invoice: Dr Bank / Cr AR.
model PaymentReceipt {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  amount         Decimal  @db.Decimal(18, 2)
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([organizationId, code])
  @@index([invoiceId])
}

// FSM-07: field labour hours on a work order → LABOUR project cost.
model Timesheet {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  workDate       DateTime @default(now())
  hours          Decimal  @db.Decimal(6, 2)
  hourlyRate     Decimal  @db.Decimal(10, 2)
  amount         Decimal  @db.Decimal(18, 2)
  memo           String?
  createdAt      DateTime @default(now())

  @@index([workOrderId])
  @@index([organizationId, userId])
}

// SCM↔FIN bridge: the supplier invoice that makes input VAT real.
model VendorBill {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId String?
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  billDate       DateTime @default(now())
  subtotal       Decimal  @default(0) @db.Decimal(18, 2)
  vatAmount      Decimal  @default(0) @db.Decimal(18, 2)
  total          Decimal  @default(0) @db.Decimal(18, 2)
  status         BillStatus @default(DRAFT)
  vendorRef      String?
  createdAt      DateTime @default(now())

  paymentAllocations VendorPaymentAllocation[]
  threeWayMatch      ThreeWayMatch?

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

// ── M1: the payables side of the cash cycle ─────────────────────────────────
// AP was only ever credited — vendor bills and approved subcontractor claims
// piled up with no way to settle them, and the bank account only ever received.

model VendorPayment {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  paymentDate    DateTime @default(now())
  amount         Decimal  @db.Decimal(18, 2)
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  memo           String?
  createdAt      DateTime @default(now())

  allocations    VendorPaymentAllocation[]

  @@unique([organizationId, code])
  @@index([organizationId, vendorId])
}

// One payment can settle several documents and one document can take several
// payments — the allocation row is what makes part-payment expressible at all.
// Exactly one of vendorBillId / progressClaimId is set (enforced in the service).
model VendorPaymentAllocation {
  id              String   @id @default(cuid())
  vendorPaymentId String
  vendorPayment   VendorPayment @relation(fields: [vendorPaymentId], references: [id], onDelete: Cascade)
  vendorBillId    String?
  vendorBill      VendorBill? @relation(fields: [vendorBillId], references: [id])
  progressClaimId String?
  progressClaim   ProgressClaim? @relation(fields: [progressClaimId], references: [id])
  amount          Decimal  @db.Decimal(18, 2)

  @@index([vendorPaymentId])
  @@index([vendorBillId])
  @@index([progressClaimId])
}

// ── M1: posting rules ───────────────────────────────────────────────────────
// Every automatic journal used to name its GL account by a hardcoded string
// ('1100', '2000', ...). That made the chart of accounts un-swappable: a
// customer with its own COA could not use the system at all. Posting code now
// asks for a *purpose* and this table answers with the account.

enum PostingPurpose {
  AR                   // trade receivables
  RETENTION_RECEIVABLE // retention withheld by our customers
  CONTRACT_ASSET       // IFRS-15 unbilled work performed
  CONTRACT_LIABILITY   // IFRS-15 over-billed revenue
  VAT_OUTPUT           // VAT charged on sales
  REVENUE              // project / settlement revenue
  WIP                  // project costs capitalised before recognition
  COST_OF_REVENUE      // WIP relieved as work is recognised
  VAT_INPUT            // deductible VAT on purchases
  AP                   // trade payables
  RETENTION_PAYABLE    // retention we withhold from subcontractors
  BANK                 // operating bank account
  CAPITAL              // owners' capital
  RETAINED_EARNINGS    // accumulated result carried forward
}

model AccountMapping {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purpose        PostingPurpose
  accountId      String
  // Restrict: an account that posting rules point at must not vanish.
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, purpose])
  @@index([organizationId])
  @@index([accountId])
}

// ── M1: fiscal calendar ─────────────────────────────────────────────────────
// Journals could be posted to any date forever — nothing could be closed, so
// nothing could be relied on. A closed period refuses new postings, and
// closing a year sweeps the result into retained earnings.

enum FiscalStatus {
  OPEN
  CLOSED
}

model FiscalYear {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  startDate      DateTime
  endDate        DateTime
  status         FiscalStatus @default(OPEN)
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime @default(now())

  periods        FiscalPeriod[]

  @@unique([organizationId, year])
  @@index([organizationId])
}

model FiscalPeriod {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYearId   String
  fiscalYear     FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  month          Int      // 1–12
  startDate      DateTime
  endDate        DateTime // inclusive: the last instant of the month
  status         FiscalStatus @default(OPEN)
  closedAt       DateTime?
  closedById     String?

  @@unique([fiscalYearId, month])
  @@index([organizationId, startDate])
}

// ── M2: attachments ─────────────────────────────────────────────────────────
// Files live on disk under UPLOADS_DIR (a docker volume in production); the DB
// row is the source of truth for existence, ownership and the download name.
// storageKey is always server-generated — client-supplied names never touch
// the filesystem path.

enum AttachmentEntity {
  CONTRACT
  INVOICE
  PROJECT
  WORK_ORDER
  CUSTOMER
  OPPORTUNITY
  // CRM Phase 1 · Step 5 (migration 0028): a file hangs off a log entry.
  ACTIVITY
}

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     AttachmentEntity
  entityId       String
  fileName       String   // original upload name — shown in the UI and used on download
  mimeType       String
  sizeBytes      Int
  storageKey     String   @unique // relative path under UPLOADS_DIR
  uploadedById   String?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId])
}

// ── M2: in-app notifications ────────────────────────────────────────────────
// Rendered bilingual text is stored (paired *_ar/_en, the project convention)
// so the bell needs no key/params plumbing. Rows are per-recipient; readAt
// null = unread.

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String   // INVOICE_ISSUED | PAYMENT_RECEIVED | CREDIT_NOTE | ALERT_WORKORDER | CLAIM_APPROVED | MILESTONE_CERTIFIED ...
  titleAr        String
  titleEn        String
  bodyAr         String?
  bodyEn         String?
  linkPath       String?  // web route, e.g. /invoices/<id>
  readAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ── Package و: the approval matrix ──────────────────────────────────────────
// Until now the system had no amount threshold anywhere: a 500 SAR purchase
// order and a 5,000,000 SAR one both needed one permission, and whoever held
// it approved either alone. These four tables make "who signs, and above what
// amount" configurable per organization without making the *states themselves*
// configurable — the lifecycle stays in code, tested.
//
// A document type with no matching rule keeps the old behaviour exactly: the
// single write permission decides. The matrix only ever adds signatures.

enum ApprovalDocument {
  // M4: the requisition is banded and signed in its own right. Without its own
  // value it would have to borrow PURCHASE_ORDER's, and the matrix would then
  // hand a requisition id to procurement's purchase-order applier.
  PURCHASE_REQUISITION
  PURCHASE_ORDER
  PROGRESS_CLAIM
  CHANGE_ORDER
  // CRM Phase 1 · Step 4: a proposal is banded on its selling total and signed
  // by the executive before it may be sent to the customer.
  PROPOSAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One amount band for one document type. Bands are half-open — minAmount is
/// inclusive, maxAmount exclusive, null maxAmount means "and above" — and the
/// service refuses to save two active bands of the same type that overlap.
model ApprovalRule {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   ApprovalDocument
  minAmount      Decimal  @default(0) @db.Decimal(18, 2)
  maxAmount      Decimal? @db.Decimal(18, 2)
  /// M4, the third dimension of the matrix. Null means the rule applies to the
  /// whole organization; a rule naming a department beats an organization-wide
  /// rule covering the same amount, which is what lets the two coexist without
  /// the overlap guard rejecting one of them.
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  /// M4: hours the current step may sit unsigned before the chain is escalated.
  /// Null = never escalate. Escalation notifies; it never signs — a control
  /// that approves things by itself when nobody is looking is not a control.
  escalationHours Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  steps    ApprovalRuleStep[]
  requests ApprovalRequest[]

  @@index([organizationId, documentType, isActive])
  @@index([organizationId, documentType, departmentId, isActive])
}

/// The signature chain of a rule, in order. Roles — not users: a chain built
/// from named people breaks the first time somebody leaves.
model ApprovalRuleStep {
  id       String @id @default(cuid())
  ruleId   String
  rule     ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  sequence Int
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id])

  @@unique([ruleId, sequence])
  @@index([roleId])
}

/// One document's trip through the matrix. `documentCode` is denormalised so
/// the inbox reads without touching three other tables; `amount` is frozen at
/// submission so a later edit cannot silently move the document into a cheaper
/// band that has already been signed.
model ApprovalRequest {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   ApprovalDocument
  documentId     String
  documentCode   String
  amount         Decimal  @db.Decimal(18, 2)
  // The rule is kept for provenance. SetNull, not Cascade: rewriting the matrix
  // must never erase the record of what was already approved under the old one.
  ruleId         String?
  rule           ApprovalRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  status         ApprovalStatus @default(PENDING)
  currentStep    Int      @default(1)
  /// When the current step became current. Escalation is measured from here,
  /// not from createdAt — otherwise a chain whose first step was signed
  /// promptly escalates its second step the moment it opens.
  currentStepAt  DateTime @default(now())
  /// The department the document belonged to when the chain opened, frozen so
  /// a later reorganisation cannot change which rule "should" have applied.
  departmentId   String?
  raisedById     String?
  raisedBy       User?    @relation("ApprovalRaiser", fields: [raisedById], references: [id])
  createdAt      DateTime @default(now())
  closedAt       DateTime?

  steps ApprovalStep[]

  @@index([organizationId, status])
  @@index([organizationId, documentType, documentId])
}

/// A materialised copy of the rule's steps, taken at submission. Copied rather
/// than referenced so editing the matrix tomorrow cannot rewrite who was
/// supposed to sign something yesterday.
model ApprovalStep {
  id          String @id @default(cuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sequence    Int
  roleId      String
  role        Role   @relation(fields: [roleId], references: [id])
  status      ApprovalStepStatus @default(PENDING)
  decidedById String?
  decidedBy   User?  @relation("ApprovalDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  note        String?
  /// Set once, the first time this step is escalated for sitting too long.
  /// Once, not every hour: an escalation that repeats itself is spam, and spam
  /// is how a real escalation ends up ignored.
  escalatedAt DateTime?
  /// The delegation used to sign this step, when one was. The trail has to be
  /// able to answer "the finance manager was on leave — who actually signed?"
  delegationId String?

  @@unique([requestId, sequence])
  @@index([roleId, status])
}

// ═══════════════════════════════════════════════════════════════════════════
// M4 — the workflow engine (المرحلة الأولى of the approved architecture)
//
// Until now every module owned its own lifecycle: a status column, an enum,
// and a service that wrote to it directly. That is why "who moved this
// document, when, and why" had no single answer, and why cross-module
// consequences (a receipt that must reach the ledger) were hand-wired calls a
// future author could simply forget to make.
//
// These six tables are the one place a document may change state. They live in
// the `public` schema like everything else — the modular boundary is enforced
// by the `wf_` prefix, the engine's single entry point, and review, not by a
// Postgres schema (which would mean enabling Prisma's multiSchema preview and
// annotating all ~75 existing models for no behavioural gain).
// ═══════════════════════════════════════════════════════════════════════════

/// Where a state sits in its flow. A document in a FINAL state is done: no
/// transition may leave it, and the engine closes the instance on arrival.
enum WfStateKind {
  INITIAL
  INTERMEDIATE
  FINAL
}

enum WfEventStatus {
  PENDING
  PROCESSED
  FAILED
}

/// One flow — "purchase requisition", "vendor bill" — at one version.
/// Versioned rather than edited in place: instances keep pointing at the
/// definition they were opened under, so changing tomorrow's flow cannot
/// rewrite the rules a document already travelled through.
model WfDefinition {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String // PURCHASE_REQUISITION | PURCHASE_ORDER | GOODS_RECEIPT | VENDOR_BILL
  nameAr         String
  nameEn         String
  documentType   String // the Prisma model this flow governs, e.g. "PurchaseOrder"
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  states      WfState[]
  transitions WfTransition[]
  instances   WfInstance[]

  @@unique([organizationId, code, version])
  @@index([organizationId, code, isActive])
  @@map("wf_definitions")
}

/// The states of one flow. `code` is stable and machine-facing; the pair of
/// name columns is what the user sees, in the project's bilingual convention.
model WfState {
  id           String   @id @default(cuid())
  definitionId String
  definition   WfDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  code         String
  nameAr       String
  nameEn       String
  kind         WfStateKind @default(INTERMEDIATE)
  sortOrder    Int      @default(0)

  transitionsFrom WfTransition[] @relation("WfTransitionFrom")
  transitionsTo   WfTransition[] @relation("WfTransitionTo")
  instances       WfInstance[]

  @@unique([definitionId, code])
  @@index([definitionId])
  @@map("wf_states")
}

/// The legal moves. A move that is not a row here cannot happen — this table
/// is the whole reason `engine.transition()` is able to refuse something.
///
/// `requiredPermission` is checked against the actor's live permission set,
/// not against whatever role existed when the flow was seeded. `conditionExpr`
/// is a deliberately tiny comparison language (see `condition.ts`) and never an
/// eval, so a row in this table can never become code execution.
model WfTransition {
  id                 String   @id @default(cuid())
  definitionId       String
  definition         WfDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fromState          String
  toState            String
  from               WfState  @relation("WfTransitionFrom", fields: [definitionId, fromState], references: [definitionId, code], onDelete: Cascade)
  to                 WfState  @relation("WfTransitionTo", fields: [definitionId, toState], references: [definitionId, code], onDelete: Cascade)
  actionCode         String // SUBMIT | APPROVE | REJECT | RETURN | SEND | CLOSE ...
  nameAr             String
  nameEn             String
  requiredPermission String
  conditionExpr      String?
  /// The event written to the outbox when this transition commits. Null means
  /// the move is internal and nothing outside the module needs to hear it.
  emitsEvent         String?
  /// When true the transition does not run on request: it opens a signature
  /// chain in the approval matrix, and only the last signature performs it.
  requiresApproval   Boolean  @default(false)
  sortOrder          Int      @default(0)

  @@unique([definitionId, fromState, actionCode])
  @@index([definitionId])
  @@index([definitionId, toState])
  @@map("wf_transitions")
}

/// The live position of one real document. One row per document, ever — the
/// unique index is what stops two flows being opened for the same PO.
model WfInstance {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definitionId   String
  definition     WfDefinition @relation(fields: [definitionId], references: [id])
  documentType   String
  documentId     String
  documentCode   String // denormalised so the task box reads without a join per row
  currentState   String
  state          WfState  @relation(fields: [definitionId, currentState], references: [definitionId, code])
  /// Who owes the next action. Role-shaped, not person-shaped: a task box built
  /// on named people empties itself the first time somebody leaves.
  assigneeRoleId String?
  assigneeRole   Role?    @relation("WfAssigneeRole", fields: [assigneeRoleId], references: [id])
  openedAt       DateTime @default(now())
  closedAt       DateTime?

  history WfHistory[]

  @@unique([organizationId, documentType, documentId])
  @@index([organizationId, documentType, currentState])
  @@index([organizationId, assigneeRoleId, closedAt])
  @@map("wf_instances")
}

/// Append-only. Never updated, never deleted — this is the audit answer to
/// "who moved it, when, from what, to what, and what did they say".
model WfHistory {
  id               String   @id @default(cuid())
  instanceId       String
  instance         WfInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  fromState        String
  toState          String
  actionCode       String
  actorId          String?
  actor            User?    @relation("WfHistoryActor", fields: [actorId], references: [id])
  /// Set when the actor signed on behalf of another role through an active
  /// delegation — the trail must say whose authority was actually used.
  onBehalfOfRoleId String?
  comment          String?
  createdAt        DateTime @default(now())

  @@index([instanceId, createdAt])
  @@map("wf_history")
}

/// The outbox. Written inside the same transaction as the state change it
/// describes, so an event cannot exist for a move that rolled back, and a move
/// cannot commit without its event. A background dispatcher drains it.
///
/// `attempts`/`nextAttemptAt` give retries with exponential back-off; a row
/// that exhausts them lands in FAILED with `lastError` intact rather than
/// disappearing, because a lost consequence must stay visible.
model DomainEvent {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventCode      String // pr.approved | po.approved | goods.received ...
  payloadJson    Json
  status         WfEventStatus @default(PENDING)
  attempts       Int      @default(0)
  lastError      String?
  nextAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  processedAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([organizationId, eventCode, createdAt])
  @@map("domain_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// M4 — the three dimensions the approval matrix was missing
// ═══════════════════════════════════════════════════════════════════════════

/// The organizational unit an approval rule can be scoped to. Introduced here
/// because "مدير القسم" in the matrix is meaningless without one — the system
/// had no notion of a department at all.
model Department {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String
  nameEn         String
  parentId       String?
  parent         Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DeptHierarchy")
  managerId      String?
  manager        User?    @relation("DeptManager", fields: [managerId], references: [id])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members       User[]                @relation("DeptMembers")
  approvalRules ApprovalRule[]
  requisitions  PurchaseRequisition[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

/// A temporary transfer of signing authority — the "إجازات المعتمدين" case.
/// Deliberately narrow: it lends the delegate the *delegator's role* for
/// approval steps only, for a bounded window, and is recorded on every
/// signature it enables. It never grants a permission the delegator lacks.
model ApprovalDelegation {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromUserId     String
  fromUser       User     @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId       String
  toUser         User     @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  isActive       Boolean  @default(true)
  createdById    String?
  createdBy      User?    @relation("DelegationCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@index([organizationId, toUserId, isActive])
  @@index([organizationId, fromUserId, isActive])
}

// ═══════════════════════════════════════════════════════════════════════════
// M4 — purchase requisition: the step the purchasing cycle never had
//
// §7 of the architecture starts the cycle at PR, not PO. Without it there is
// no record of *who asked* for a spend before someone committed the company to
// it — the request and the commitment were the same document.
// ═══════════════════════════════════════════════════════════════════════════

enum PrStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETURNED
  CONVERTED
  CANCELLED
}

model PurchaseRequisition {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  /// Free text, deliberately required: a requisition with no stated need is
  /// the thing an auditor asks about first.
  justification  String
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  requestedById  String?
  requestedBy    User?    @relation("PrRequester", fields: [requestedById], references: [id])
  neededBy       DateTime?
  status         PrStatus @default(DRAFT)
  currency       String   @default("SAR")
  estimatedTotal Decimal  @default(0) @db.Decimal(18, 2)
  /// Set when the approved requisition became a PO. One PR, one PO — a second
  /// conversion would double-commit the same request.
  purchaseOrderId String? @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines PurchaseRequisitionLine[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
}

model PurchaseRequisitionLine {
  id            String  @id @default(cuid())
  requisitionId String
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item    @relation(fields: [itemId], references: [id])
  wbsElementId  String?
  wbsElement    WbsElement? @relation(fields: [wbsElementId], references: [id])
  qty           Decimal @default(1) @db.Decimal(14, 3)
  estimatedUnitPrice Decimal @default(0) @db.Decimal(18, 2)
  lineTotal     Decimal @default(0) @db.Decimal(18, 2)
  notes         String?

  @@index([requisitionId])
}

// ═══════════════════════════════════════════════════════════════════════════
// M4 — the commitment ledger
//
// §6: `po.approved ← إنشاء التزام محاسبي`. The system tracked actual cost
// (ProjectCostEntry) but never committed cost, so a project could be fully
// spent on paper and still have half a million riyals of approved POs in
// flight against it. Append-only, like the actuals ledger: a release is a
// negative row, never an edit.
// ═══════════════════════════════════════════════════════════════════════════

model ProjectCommitment {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  wbsElementId   String?
  wbsElement     WbsElement? @relation(fields: [wbsElementId], references: [id])
  sourceType     String // "PurchaseOrder" | "SubcontractAgreement" | "Release"
  sourceId       String
  amount         Decimal  @db.Decimal(18, 2) // negative on releasing rows
  memo           String?
  createdAt      DateTime @default(now())

  @@index([organizationId, projectId])
  @@index([sourceType, sourceId])
}

// ═══════════════════════════════════════════════════════════════════════════
// M4 — three-way match (أمر شراء / استلام / فاتورة)
//
// §7 makes "مطابقة ثلاثياً" a state a vendor bill must pass through. The match
// itself is a record, not a boolean: an auditor needs the three quantities and
// the three amounts that were compared, and the tolerance that was applied.
// ═══════════════════════════════════════════════════════════════════════════

enum MatchResult {
  MATCHED
  QTY_VARIANCE
  PRICE_VARIANCE
  BOTH_VARIANCE
}

model ThreeWayMatch {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorBillId   String   @unique
  vendorBill     VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  result         MatchResult
  orderedQty     Decimal  @db.Decimal(14, 3)
  receivedQty    Decimal  @db.Decimal(14, 3)
  billedQty      Decimal  @db.Decimal(14, 3)
  receivedValue  Decimal  @db.Decimal(18, 2)
  billedValue    Decimal  @db.Decimal(18, 2)
  /// The variance actually allowed when this match ran, frozen here: changing
  /// the tolerance next quarter must not silently re-judge last quarter.
  tolerancePct   Decimal  @db.Decimal(6, 3)
  detailJson     Json?
  matchedAt      DateTime @default(now())
  matchedById    String?

  @@index([organizationId, result])
}
