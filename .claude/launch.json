{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 4000
    },
    {
      "name": "copilot",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "dotenv",
        "-e",
        ".env",
        "-v",
        "COPILOT_PORT=3110",
        "--",
        "npm",
        "run",
        "dev",
        "-w",
        "@npi/copilot"
      ],
      "port": 3110
    }
  ]
}
