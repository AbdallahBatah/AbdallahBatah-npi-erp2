# انسخ هذا الملف إلى deploy/.env وعدّل القيم — لا ترفع deploy/.env لأي مكان عام.

# كلمة مرور قاعدة البيانات (اختر كلمة قوية عشوائية)
POSTGRES_PASSWORD=ChangeMe_StrongDbPassword

# سر توقيع الجلسات — ولّده بأمر: openssl rand -hex 32
JWT_SECRET=ChangeMe_Run_openssl_rand_hex_32

# مدة صلاحية الجلسة
JWT_EXPIRES_IN=12h

# عنوان الموقع:
#   :80                    → HTTP على عنوان IP مباشرة (بلا دومين)
#   203-0-113-10.sslip.io  → HTTPS تلقائي بلا شراء دومين (استبدل بأرقام IP خادمك مفصولة بشرطات)
#   demo.npi-erp.sa        → HTTPS تلقائي عند امتلاك دومين
SITE_ADDRESS=:80

# توثيق OpenAPI على /api/docs و/api/docs-json — علم بيئة تشغيل (يُقرأ من
# الـAPI وقت التشغيل). في أي بيئة إنتاجية اتركه فارغاً/0 فيختفي التوثيق
# (404). خادم العرض التجريبي وحده يضبطه 1 في نسخة deploy/.env الخاصة به.
EXPOSE_API_DOCS=0

# تعبئة بيانات الدخول التجريبية (admin@npi.sa) مسبقاً في شاشة /login — علم
# وقت البناء (Next.js NEXT_PUBLIC_*) يُخبز داخل صورة الواجهة عند
# `docker build`، لا يُقرأ وقت التشغيل. في أي بيئة إنتاجية اتركه فارغاً/0
# فتبدأ الحقول فارغة. خادم العرض التجريبي وحده يضبطه 1 (يمرَّر إلى
# apps/web/Dockerfile كـbuild arg عبر docker-compose.prod.yml).
NEXT_PUBLIC_DEMO_PREFILL=0
