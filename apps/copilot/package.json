{
  "name": "@npi/copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "dotenv -e ../../.env -- node scripts/run-next.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "test": "jest",
    "e2e": "playwright test",
    "e2e:live-setup": "dotenv -v COPILOT_LIVE=1 -- playwright test --grep @live-setup --project desktop",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "pretest": "prisma generate",
    "gen-types": "node scripts/gen-npi-types.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@prisma/client": "5.22.0",
    "lucide-react": "1.48.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.5.4",
    "dotenv-cli": "7.4.4",
    "jest": "30.4.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.23",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.19",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  }
}
