# انسخ هذا الملف إلى deploy/.env وعدّل القيم — لا ترفع deploy/.env لأي مكان عام.

# كلمة مرور قاعدة البيانات (اختر كلمة قوية عشوائية)
POSTGRES_PASSWORD=ChangeMe_StrongDbPassword

# سر توقيع الجلسات — ولّده بأمر: openssl rand -hex 32
JWT_SECRET=ChangeMe_Run_openssl_rand_hex_32

# مدة صلاحية الجلسة
JWT_EXPIRES_IN=12h

# عنوان الموقع:
#   :80                    → HTTP على عنوان IP مباشرة (بلا دومين)
#   203-0-113-10.sslip.io  → HTTPS تلقائي بلا شراء دومين (استبدل بأرقام IP خادمك مفصولة بشرطات)
#   demo.npi-erp.sa        → HTTPS تلقائي عند امتلاك دومين
SITE_ADDRESS=:80

# توثيق OpenAPI على /api/docs و/api/docs-json — علم بيئة تشغيل (يُقرأ من
# الـAPI وقت التشغيل). في أي بيئة إنتاجية اتركه فارغاً/0 فيختفي التوثيق
# (404). خادم العرض التجريبي أيضاً يتركه مطفأً (قرار المالك 2026-09-27)؛
# يُضبط 1 في التطوير المحلي فقط عند الحاجة.
EXPOSE_API_DOCS=0

# تعبئة بيانات الدخول التجريبية (admin@npi.sa) مسبقاً في شاشة /login — علم
# وقت البناء (Next.js NEXT_PUBLIC_*) يُخبز داخل صورة الواجهة عند
# `docker build`، لا يُقرأ وقت التشغيل. في أي بيئة إنتاجية اتركه فارغاً/0
# فتبدأ الحقول فارغة. خادم العرض التجريبي أيضاً يتركه مطفأً (قرار المالك
# 2026-09-27). يمرَّر إلى apps/web/Dockerfile كـbuild arg عبر
# docker-compose.prod.yml.
NEXT_PUBLIC_DEMO_PREFILL=0

# ─── الكوبايلوت «مَدار» (apps/copilot) — يُقرأ من خدمة copilot وحدها ───
# مفتاح Anthropic الخاص بالكوبايلوت (console.anthropic.com). لا يصل إلى api أو web.
ANTHROPIC_API_KEY=ChangeMe_sk-ant-...

# مفتاح تشفير جلسات الكوبايلوت (32 بايت hex) — ولّده بأمر: openssl rand -hex 32
# مستقل تماماً عن سر توقيع NPI أعلاه؛ الكوبايلوت لا يرى أسرار NPI.
COPILOT_SESSION_KEY=ChangeMe_Run_openssl_rand_hex_32

# اختياري — معرّفات النماذج وسقف رموز النموذج اليومي؛ عند تركها فارغة تُطبَّق
# الافتراضيات المكتوبة في docker-compose.prod.yml.
# COPILOT_MODEL_ECONOMY=claude-haiku-4-5-20251001
# COPILOT_MODEL_ADVANCED=claude-sonnet-5
# COPILOT_DAILY_TOKEN_CAP=600000
