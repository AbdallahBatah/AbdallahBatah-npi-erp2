  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "prisma": "5.22.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "@types/jest": "30.0.0",
    "dotenv-cli": "7.4.4",
    "openapi-typescript": "7.13.0"
